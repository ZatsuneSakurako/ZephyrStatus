{
  "name": "Zephyr Status",
  "version": "1.0.0",
  "description": "Whispers every page's HTTP status straight into the toolbar badge — color-coded 2xx, 3xx, 4xx and 5xx at a glance.",
  "author": "Zatsune Sakurako",

  "manifest_version": 3,
  "minimum_chrome_version": "146.0",

  "icons": {
    "16": "icons/zephyr-16.png",
    "32": "icons/zephyr-32.png",
    "48": "icons/zephyr-48.png",
    "128": "icons/zephyr-128.png"
  },

  "background": {
    "service_worker": "main.js",
    "scripts": ["main.js"],
    "type": "module"
  },

  "permissions": ["webRequest", "webNavigation", "storage"],

  "host_permissions": ["<all_urls>"],

  "action": {
    "default_title": "Zephyr Status",
    "default_icon": {
      "16": "icons/zephyr-16.png",
      "32": "icons/zephyr-32.png",
      "48": "icons/zephyr-48.png",
      "128": "icons/zephyr-128.png"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "{d56a5b99-51b9-4e83-ab23-796216679614}",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
